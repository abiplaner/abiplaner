{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Abiplaner",
  "version": "1.0.1",
  "identifier": "de.abiplaner-bayern.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Abiplaner",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage"
    ],
    "category": "Education",
    "copyright": "AGPL-3.0",
    "shortDescription": "Planung der Abiturprüfungen",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/app/": "app/",
      "../build/laufzeit/": "laufzeit/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1OThEQTVGRjBGN0E3ODAKUldTQXAvZndYOXFZNWFKNEZQZTFTYzFXK1BuWXB4MDlPMXJZNFJjZk5scHExRUJidWQxZGpobDEK",
      "endpoints": [
        "https://abiplaner-bayern.de/downloads/desktop/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
