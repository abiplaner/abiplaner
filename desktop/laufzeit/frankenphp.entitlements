<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sonderrechte für die PHP-Laufzeit (FrankenPHP) unter Hardened Runtime.
  allow-jit: PCRE2 (preg_*) übersetzt reguläre Ausdrücke zur Laufzeit in
  Maschinencode und braucht dafür MAP_JIT-Speicher. Ohne dieses Recht
  meldet PHP bei jedem preg_*-Aufruf "Allocation of JIT memory failed".
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
