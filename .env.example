APP_NAME=AbiPlaner
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Der Host ist der Name des Datenbank-Containers aus docker-compose.
DB_CONNECTION=mysql
DB_HOST=abiplaner_db
DB_PORT=3306
DB_DATABASE=abiplaner
DB_USERNAME=abiplaner
DB_PASSWORD=

# --- Cache, Session, Queue ---
# Vorgabe: 'Light'-Setup ohne Redis — Cache und Sessions in der Datenbank,
# Jobs laufen synchron.
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

SESSION_DRIVER=database
# Security-Checkliste L2: bewusst kurz gehalten (Empfehlung: 480-720 Min. / 8-12h)
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Security-Checkliste M3/M4: In Produktion (HTTPS) unbedingt setzen:
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true (optional, zusätzliche Härtung)

# --- Full Stack (optional, docker/docker-compose.extended.yml) ---
# Redis für Cache und Queue, MailHog zum Abfangen der Mails.
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=abiplaner_redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# MAIL_MAILER=smtp
# MAIL_HOST=abiplaner_mailhog
# MAIL_PORT=1025

# --- Mail ---
# Ohne Angabe landet jede Mail nur im Log (MAIL_MAILER=log).
# Produktion: eigener SMTP-Relay, z. B.
# MAIL_MAILER=smtp
# MAIL_HOST=mail.example.org
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="abiplaner@example.org"
# MAIL_FROM_NAME="${APP_NAME}"
#
# Nur noetig, wenn der Relay auch per IPv6 aufloest, das Docker-Netz aber kein
# IPv6 hat: docker-compose.yml traegt dann diesen Namen mit dieser IPv4 als
# extra_hosts ein (`getent ahostsv4 mail.example.org` auf dem Host).
# MAIL_PIN_HOST=mail.example.org
# MAIL_PIN_IPV4=

# --- Support-Organisation (Modul 6.4) ---
# Wohin die Eskalationsmail einer Fehlermeldung geht. Leer heisst: kein
# Mailversand, die Faelle stehen nur im Dashboard.
# `php artisan support:testmail` prueft den Weg — und sagt ausdruecklich, wenn
# MAIL_MAILER=log gesetzt ist und gar nichts hinausgeht.
SUPPORT_EMPFAENGER=

# Aufbewahrungsfristen der Fallakten (Entscheidung 53). Alle Fristen zaehlen ab
# dem Abschluss des Falls; ein offener Fall wird nie angefasst. Die Werte hier
# sind die Vorgabe — config/support.php erklaert, wie sie zustande kommen.
SUPPORT_AUFBEWAHRUNG_KONTEXT_TAGE=90
SUPPORT_AUFBEWAHRUNG_FALLAKTE_MONATE=24
SUPPORT_AUFBEWAHRUNG_OFFEN_HINWEIS_MONATE=12

# --- Dateiablage in S3 (optional, nur bei FILESYSTEM_DISK=s3) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
